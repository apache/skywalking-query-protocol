type GenAIEvaluationRecords {
    genAIEvaluationRecordList: [GenAIEvaluationRecord!]!
    debuggingTrace: DebuggingTrace
}

type GenAIEvaluationRecord {
    traceId: String
    serviceId: String
    serviceName: String
    providerId: String
    providerName: String
    modelId: String
    modelName: String
    operationName: String
    # The value type determines which field contains the evaluation value.
    # SCORE and BOOLEAN use scoreValue; STRING and JSON use value.
    valueType: GenAIEvaluationValueType
    # Numeric value stored in evaNumberValue. It is populated for SCORE and BOOLEAN.
    scoreValue: Float
    # String or JSON value stored in evalStringValue. It is populated for STRING and JSON.
    value: String
    segmentId: String
    spanId: String
    spanType: String
    taskName: String
    evaluationLevel: String
    reason: String
    judgeModel: String
    evaluationTime: Long
}

enum GenAIEvaluationRecordSortBy {
    EVALUATION_TIME
    SCORE_VALUE
}

enum GenAIEvaluationValueType {
    SCORE
    BOOLEAN
    STRING
    JSON
}

input GenAIEvaluationRecordTag {
    key: String!
    value: String
}

input GenAIEvaluationRecordQueryCondition {
    serviceId: ID
    providerId: ID
    modelId: ID
    # Filter value_type first when selecting a specific evaluation kind.
    valueType: GenAIEvaluationValueType
    # Bounds for evaNumberValue, used with SCORE or BOOLEAN value types.
    minScore: Long
    maxScore: Long
    sortBy: GenAIEvaluationRecordSortBy
    taskName: String
    evaluationLevel: String
    judgeModel: String
    relatedTrace: TraceScopeCondition
    queryDuration: Duration
    paging: Pagination!
    tags: [GenAIEvaluationRecordTag!]
    queryOrder: Order
}

extend type Query {
    queryGenAIEvaluationRecord(condition: GenAIEvaluationRecordQueryCondition, debug: Boolean): GenAIEvaluationRecords
}